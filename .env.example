# Admin bearer token (for creating API keys via the REST API)
ADMIN_BEARER_TOKEN=changeme123

# Transcription settings
MAX_AUDIO_SIZE_MB=256

# Whisper model settings
WHISPER_MODEL=distil-large-v3
# auto picks CUDA if a GPU is available, else CPU. Force with "cuda" or "cpu".
# AMD/Intel GPUs aren't supported by the inference engine either way — CPU is
# the only fallback on non-NVIDIA hardware.
WHISPER_DEVICE=auto
# Defaults to float16 on CUDA, int8 on CPU (int8 is a quality/speed tradeoff,
# not just a size one — override if you want float32 accuracy on CPU).
WHISPER_COMPUTE_TYPE=

# Max seconds before a transcription job is marked failed
JOB_TIMEOUT_SECONDS=3600

# ---------------------------------------------------------------------------
# Pull-worker (optional)
# Set WEB_URL to enable pull-worker mode. When set, blurb_manager starts
# web_worker.py automatically unless BLURB_AUTO_START_WORKER is false.
# ---------------------------------------------------------------------------

# Base URL for the remote API. Blurb appends /worker/jobs/next, /worker/jobs/{id}/complete, etc.
# e.g. https://palpal.app/api
WEB_URL=

# Shared API key for remote authentication (must match BLURB_API_KEY on the server)
BLURB_API_KEY=

# Start the worker automatically when the manager opens (default: true)
BLURB_AUTO_START_WORKER=true

# Optional one-shot mode: after draining the queue, exit on the first empty
# poll instead of waiting for new work. Network errors do not trigger this.
BLURB_QUIT_WHEN_IDLE=false

# Seconds to wait between polls when no job is available (default: 5)
POLL_INTERVAL=5

# Seconds between liveness pings, independent of job polling (default: 60).
# This is what drives the "blurb connected" indicator in the admin panel.
HEARTBEAT_INTERVAL=60

# ---------------------------------------------------------------------------
# YouTube / Patreon cookies (optional)
# Discovery and download run here, not on the server, specifically so these
# credentials never leave this machine. Export a Netscape-format cookies.txt
# from your browser (e.g. with a "Get cookies.txt" extension) and point these
# at the file. Leave unset if you don't need age-restricted YouTube content
# or any Patreon sources.
# ---------------------------------------------------------------------------

# Path to a cookies.txt containing your YouTube session — only needed for
# age-restricted videos.
YOUTUBE_COOKIES_FILE=

# Path to a cookies.txt containing your Patreon session — required for any
# Patreon source (discovery and download both need it).
PATREON_COOKIES_FILE=
